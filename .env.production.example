# Copy to `.env` on the VM and fill in real values. Do not commit the filled-in file.
#
# NODE_ENV: keep this NOT "production" until a domain + TLS (HTTPS) is set up in front
# of the app. The auth cookie is set with `secure: true` whenever NODE_ENV=production
# (apps/api/modules/auth/auth.controller.ts), and browsers refuse secure cookies over
# plain HTTP — login would appear to succeed but the session cookie would never stick.
# Switch this to "production" only after HTTPS is live (see Phase D in the deploy plan).
NODE_ENV=staging

DB_USER=postgres
DB_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@db:5432/fintalk?schema=public

JWT_SECRET=change-me-generate-a-new-one-do-not-reuse-local

# Set to the VM's public IP (e.g. http://<elastic-ip>) reachable through nginx on port 80.
FRONTEND_URL=

GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# NEXT_PUBLIC_API_URL is baked into the frontend at build time (Next.js), not read at
# container runtime. It's passed as a Docker build arg (see docker-compose.prod.yml /
# `make deploy`), so make sure it's exported in this shell/`.env` before building, e.g.
# NEXT_PUBLIC_API_URL=http://<elastic-ip>/api
NEXT_PUBLIC_API_URL=
